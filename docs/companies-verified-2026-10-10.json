    "rippling: https://api.rippling.com/platform/api/ats/v1/board/{slug}/jobs",
    "bamboohr: https://{slug}.bamboohr.com/careers/list with header accept: application/json",
    "workday: POST https://{host}/wday/cxs/{tenant}/{site}/jobs body {\"appliedFacets\":{},\"limit\":20,\"offset\":0,\"searchText\":\"\"} header content-type: application/json. total caps at 2000.",
    "oracle: https://{host}/hcmRestApi/resources/latest/recruitingCEJobRequisitions?onlyData=true&expand=requisitionList&finder=findReqs;siteNumber={site},limit=50 (add ,keyword=web inside finder)",
    "successfactors: https://{host}/services/rss/job/?locale=en_US&keywords={kw} (RSS XML, 20 items per query, poll per keyword)",
    "radancy: https://{host}/search-jobs/results?CurrentPage=1&RecordsPerPage=100&Keywords=&SearchType=5 header X-Requested-With: XMLHttpRequest (JSON wrapping HTML, titles in h2)",
    "Treat 0 jobs from any feed as a failed fetch, not an empty day. Ashby gives isRemote per job; Greenhouse only has location.name."
